<Window x:Class="OptionRollerUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OptionRollerUI.ViewModels"
        xmlns:models="clr-namespace:OptionRollerUI.Models"
        Title="OptionRoller — Deribit"
        Icon="app.ico"
        Width="1100" Height="720"
        MinWidth="900" MinHeight="600"
        Background="{StaticResource BgDark}"
        FontFamily="Consolas">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="120"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="200" MinHeight="60"/>
        </Grid.RowDefinitions>

        <!-- ── Title bar ── -->
        <Border Grid.Row="0" Background="{StaticResource BgPanel}"
                CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
            <TextBlock Text="⬡  OPTION ROLL STRATEGY  — DERIBIT"
                       FontSize="15" FontWeight="Bold"
                       Foreground="{StaticResource Accent}"/>
        </Border>

        <!-- ── Main area ── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Settings panel -->
            <Border Grid.Column="0" Background="{StaticResource BgPanel}"
                    CornerRadius="4" Padding="14">
                <StackPanel>
                    <TextBlock Text="SETTINGS" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource Accent}" Margin="0,0,0,10"/>

                    <Label Content="Currency (BTC / ETH / SOL)"/>
                    <TextBox Text="{Binding Currency, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,2,0,8"/>

                    <Label Content="Expiration  (yyyy-MM-dd)"/>
                    <TextBox Text="{Binding Expiration, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,2,0,8"/>

                    <Label Content="Call Strike  (0 = любой)"/>
                    <TextBox Text="{Binding CallStrike, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,2,0,8"/>

                    <Label Content="Put Strike  (0 = любой)"/>
                    <TextBox Text="{Binding PutStrike, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,2,0,8"/>

                    <Label Content="Diff  (delta imbalance threshold)"/>
                    <TextBox Text="{Binding Diff, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,2,0,8"/>

                    <Label Content="Strategy Type"/>
                    <ComboBox ItemsSource="{Binding StrategyTypes}"
                              SelectedItem="{Binding StrategyType}"
                              Margin="0,2,0,8"/>

                    <CheckBox Content="  Use Testnet"
                              IsChecked="{Binding UseTestnet}"
                              Foreground="{StaticResource TextPrimary}"
                              FontFamily="Consolas" FontSize="12"
                              Margin="0,4,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="START"
                                Command="{Binding StartCommand}"
                                Background="#50FA7B" Foreground="#1E1E2E"/>
                        <Button Grid.Column="2" Content="STOP"
                                Command="{Binding StopCommand}"
                                Background="{StaticResource AccentRed}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Right: status + positions -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Status bar -->
                <Border Grid.Row="0" Background="{StaticResource BgPanel}"
                        CornerRadius="4" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Status -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Margin="0,0,6,0"
                                     Fill="{Binding StatusColor}"/>
                            <TextBlock Text="{Binding StatusText}" FontSize="14" FontWeight="Bold"
                                       Foreground="{Binding StatusColor}"/>
                        </StackPanel>

                        <!-- Deltas -->
                        <StackPanel Grid.Column="2" Margin="24,0">
                            <TextBlock Foreground="{StaticResource TextSecondary}" Text="CALL Δ" FontSize="10"/>
                            <TextBlock Text="{Binding CallDelta}" FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource AccentGreen}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Margin="24,0">
                            <TextBlock Foreground="{StaticResource TextSecondary}" Text="PUT Δ" FontSize="10"/>
                            <TextBlock Text="{Binding PutDelta}" FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource AccentRed}"/>
                        </StackPanel>

                        <!-- Last action -->
                        <StackPanel Grid.Column="4" MaxWidth="340">
                            <TextBlock Foreground="{StaticResource TextSecondary}" Text="LAST ACTION" FontSize="10"/>
                            <TextBlock Text="{Binding LastAction}" TextWrapping="Wrap"
                                       FontSize="11" Foreground="{StaticResource AccentYellow}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Positions table -->
                <Border Grid.Row="2" Background="{StaticResource BgPanel}"
                        CornerRadius="4" Padding="10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="POSITIONS"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource Accent}" Margin="0,0,0,8"/>

                        <ListView ItemsSource="{Binding Positions}"
                                  BorderThickness="1" SelectionMode="Single">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Side" Width="55"
                                                    DisplayMemberBinding="{Binding Side}"/>
                                    <GridViewColumn Header="Instrument" Width="260"
                                                    DisplayMemberBinding="{Binding Instrument}"/>
                                    <GridViewColumn Header="Size" Width="80"
                                                    DisplayMemberBinding="{Binding Size}"/>
                                    <GridViewColumn Header="Delta" Width="90"
                                                    DisplayMemberBinding="{Binding Delta}"/>
                                </GridView>
                            </ListView.View>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Accent}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ── Splitter ── -->
        <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch"
                      Background="{StaticResource BorderColor}" Cursor="SizeNS"/>

        <!-- ── Activity log ── -->
        <Border Grid.Row="3" Background="{StaticResource BgPanel}"
                CornerRadius="4" Padding="10" Margin="0,8,0,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Text="ACTIVITY LOG" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource Accent}"/>
                    <Button DockPanel.Dock="Right" Content="Clear" FontSize="10"
                            Padding="8,2" HorizontalAlignment="Right"
                            Command="{Binding ClearLogCommand}"
                            Background="{StaticResource BgInput}"/>
                </DockPanel>
                <ListBox ItemsSource="{Binding Logs}"
                         Background="{StaticResource BgInput}"
                         BorderBrush="{StaticResource BorderColor}"
                         Foreground="{StaticResource TextPrimary}"
                         FontFamily="Consolas" FontSize="11"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
